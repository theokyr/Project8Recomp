+bool RegisterBitTestRange(const uint64_t* words, uint32_t first, uint32_t last) {
+  uint32_t first_word = first >> 6;
+  uint32_t last_word = last >> 6;
+  uint32_t first_bit = first & 63;
+  uint32_t last_bit = last & 63;
