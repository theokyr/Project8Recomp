diff --git a/src/graphics/shared_memory.cpp b/src/graphics/shared_memory.cpp
index 78e1a80..6f21e0e 100644
--- a/src/graphics/shared_memory.cpp
+++ b/src/graphics/shared_memory.cpp
@@ -13,6 +13,7 @@
 #include <cstring>
 #include <utility>
 
+#include <rex/graphics/flags.h>
 #include <rex/assert.h>
 #include <rex/bit.h>
 #include <rex/dbg.h>
@@ -396,10 +397,17 @@ void SharedMemory::MakeRangeValid(uint32_t start, uint32_t length, bool written_
   }
 
   if (memory_invalidation_callback_handle_) {
-    PERF_counter_inc(kWatchRearms);
-    memory().EnablePhysicalMemoryAccessCallbacks(
-        valid_page_first << page_size_log2_,
-        (valid_page_last - valid_page_first + 1) << page_size_log2_, true, false);
+    // Measurement oracle, NOT a feature. Skipping the re-arm leaves guest pages
+    // writable, so writes stop invalidating and the GPU renders stale geometry -
+    // the output is wrong by construction. Its only purpose is to put a hard
+    // upper bound on what any write-watch redesign could recover, before one is
+    // built. mprotect from here is 35.8% of the command-processor thread.
+    if (!REXCVAR_GET(gpu_watch_rearm_oracle)) {
+      PERF_counter_inc(kWatchRearms);
+      memory().EnablePhysicalMemoryAccessCallbacks(
+          valid_page_first << page_size_log2_,
+          (valid_page_last - valid_page_first + 1) << page_size_log2_, true, false);
+    }
   }
 }
 
diff --git a/src/graphics/flags.cpp b/src/graphics/flags.cpp
index a5ec972..44cbe65 100644
--- a/src/graphics/flags.cpp
+++ b/src/graphics/flags.cpp
@@ -45,6 +45,11 @@ REXCVAR_DEFINE_BOOL(gpu_debug_markers, false, "GPU",
 // Native residency. The master switch and every subsystem switch default to
 // the emulated path, so an unconfigured run is bit-identical to a build
 // without this patch.
+REXCVAR_DEFINE_BOOL(gpu_watch_rearm_oracle, false, "GPU",
+                    "MEASUREMENT ONLY - skip re-arming the GPU write watch in MakeRangeValid. "
+                    "Renders stale geometry by design; exists to bound what a write-watch "
+                    "redesign could recover before one is built");
+
 REXCVAR_DEFINE_BOOL(gpu_native_residency, false, "GPU",
                     "Make draw vertex/index data resident by copying it from guest memory "
                     "instead of page-watching it. Latched once per frame at swap.")
diff --git a/include/rex/graphics/flags.h b/include/rex/graphics/flags.h
index 6c81128..6814495 100644
--- a/include/rex/graphics/flags.h
+++ b/include/rex/graphics/flags.h
@@ -74,6 +74,7 @@ REXCVAR_DECLARE(bool, use_fuzzy_alpha_epsilon);
 // Policy switches for the native-residency draw path and its telemetry. Every
 // one of them defaults to the emulated behavior, so a build with this header
 // behaves exactly like a build without it until a cvar is flipped.
+REXCVAR_DECLARE(bool, gpu_watch_rearm_oracle);
 REXCVAR_DECLARE(bool, gpu_native_residency);
 REXCVAR_DECLARE(bool, gpu_native_index);
 REXCVAR_DECLARE(bool, gpu_native_vertex);
