diff --git a/include/rex/perf/counter.h b/include/rex/perf/counter.h
index 803f335..382b455 100644
--- a/include/rex/perf/counter.h
+++ b/include/rex/perf/counter.h
@@ -66,6 +66,33 @@ enum class CounterId : uint16_t {
   kSharedPageOverlaps,
   kCpDrainUs,
 
+  // Host memory. Written from whichever guest thread took the fault.
+  // Counts the benign racing-unwatch recoveries in the physical-memory access
+  // violation handler, which used to be one warning per event -- this is the
+  // canary for asymmetric watch state, tracked per frame instead of by grep.
+  kStaleProtectRecoveries,
+
+  // Native residency, second wave. APPEND-ONLY RULE: every new CounterId goes
+  // here, directly before kCount, never inserted mid-enum - the frames.csv
+  // column set is positional at write time, so an insert silently renames
+  // every column after it in every previously written CSV. On any change to
+  // this enum, re-check all six consumers: this header (installed - refresh
+  // the prefix's include/ copy), kCounterNames and kIsGauge in
+  // src/core/perf/counter.cpp (both static_assert-guarded against kCount),
+  // the frames.csv emitter (trailing append only), the gpu_native_stats
+  // printer in src/graphics/flags.cpp, the debug overlay in
+  // src/ui/overlay/debug_overlay.cpp, and the residency report parser
+  // (resolves by header name, so it only needs a new CounterSpec to report
+  // the column).
+  //
+  // Counts fingerprint hits demoted to re-uploads because something else was
+  // written into the shared memory buffer over the range since it was last
+  // copied in - an overlapping native window or a page-granular emulated
+  // upload. This is the attribution instrument for the overlapping-range
+  // clobber: a steady nonzero rate says the hazard is live in real content, a
+  // hard zero across a long soak says it never fires in this title.
+  kNativeSeqEvictions,
+
   kCount  // sentinel -- must be last
 };
 
diff --git a/src/core/perf/counter.cpp b/src/core/perf/counter.cpp
index 455c34a..3d64806 100644
--- a/src/core/perf/counter.cpp
+++ b/src/core/perf/counter.cpp
@@ -61,6 +61,8 @@ constexpr const char* kCounterNames[] = {
     "request_range_texture_bytes",
     "shared_page_overlaps",
     "cp_drain_us",
+    "stale_protect_recoveries",
+    "native_seq_evictions",
 };
 static_assert(std::size(kCounterNames) == kNumCounters, "kCounterNames must match CounterId enum");
 
@@ -96,6 +98,8 @@ constexpr bool kIsGauge[] = {
     false,  // kRequestRangeTextureBytes
     false,  // kSharedPageOverlaps        (set once per frame)
     false,  // kCpDrainUs                 (set once per frame)
+    false,  // kStaleProtectRecoveries
+    false,  // kNativeSeqEvictions
 };
 static_assert(std::size(kIsGauge) == kNumCounters, "kIsGauge must match CounterId enum");
 
diff --git a/src/system/xmemory.cpp b/src/system/xmemory.cpp
index ca7f4e8..7f69bb2 100644
--- a/src/system/xmemory.cpp
+++ b/src/system/xmemory.cpp
@@ -20,6 +20,7 @@
 #include <rex/cvar.h>
 #include <rex/logging.h>
 #include <rex/math.h>
+#include <rex/perf/counter.h>
 #include <rex/stream.h>
 #include <rex/system/function_dispatcher.h>
 #include <rex/system/mmio_handler.h>
@@ -487,9 +488,16 @@ bool Memory::AccessViolationCallback(std::unique_lock<std::recursive_mutex> glob
         memory::kMemoryProtectWrite | memory::kMemoryProtectWriteCombine;
     uint32_t guest_protect = 0;
     bool allow_write = false;
+    // Direct hit: guest metadata already says writable and only the host
+    // protection is behind. That is the benign racing-unwatch case (T2 clears a
+    // watch while T1 is already faulted on it), which fires hundreds of times
+    // per run; it is counted rather than warned about. The fallbacks below mean
+    // the tracking itself went stale, so they keep the warning.
+    bool guest_protect_already_writable = false;
     if (heap->QueryProtect(virtual_address, &guest_protect) &&
         (guest_protect & kWriteProtectMask)) {
       allow_write = true;
+      guest_protect_already_writable = true;
     } else {
       // If write-watch left current protect stale, trust committed allocation
       // metadata first for this alias.
@@ -527,10 +535,18 @@ bool Memory::AccessViolationCallback(std::unique_lock<std::recursive_mutex> glob
           reinterpret_cast<uintptr_t>(host_address) & ~(uintptr_t(host_page_size - 1));
       if (rex::memory::Protect(reinterpret_cast<void*>(page_base), host_page_size,
                                rex::memory::PageAccess::kReadWrite, nullptr)) {
-        REXSYS_WARN(
-            "Recovered stale physical page protection for guest {:08X} (host {:016X}, "
-            "guest_protect {:08X})",
-            virtual_address, static_cast<uint64_t>(page_base), guest_protect);
+        if (guest_protect_already_writable) {
+          PERF_counter_inc(kStaleProtectRecoveries);
+          REXSYS_DEBUG(
+              "Recovered stale physical page protection for guest {:08X} (host {:016X}, "
+              "guest_protect {:08X})",
+              virtual_address, static_cast<uint64_t>(page_base), guest_protect);
+        } else {
+          REXSYS_WARN(
+              "Recovered stale physical page protection for guest {:08X} (host {:016X}, "
+              "guest_protect {:08X})",
+              virtual_address, static_cast<uint64_t>(page_base), guest_protect);
+        }
         return true;
       }
     }
