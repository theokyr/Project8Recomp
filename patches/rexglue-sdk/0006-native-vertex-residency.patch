+bool VulkanSharedMemory::UploadRangeUnwatchedImpl(uint32_t guest_offset, uint32_t size,
+                                                  const void* host_src) {
+  // Same ordering discipline as UploadRanges - make the buffer a transfer
+  // destination for the range about to be written and flush the barrier before
+  // recording the copy, so it lands ahead of any draw recorded after this
+  // point. Unlike UploadRanges the range is in bytes rather than in pages, and
+  // nothing is marked valid on the way through.
+  Use(Usage::kTransferDestination, std::make_pair(guest_offset, size));
+  command_processor_.SubmitBarriers(true);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  uint64_t submission_current = command_processor_.GetCurrentSubmission();
+
+  // A no-op unless a trace is being written, and the native path is not
+  // supposed to be on while one is - kept so the record stays honest if it ever
+  // is.
+  trace_writer_.WriteMemoryRead(guest_offset, size, host_src);
+
+  const uint8_t* source = reinterpret_cast<const uint8_t*>(host_src);
+  uint32_t upload_range_start = guest_offset;
+  uint32_t upload_range_length = size;
+  bool successful = true;
+  upload_regions_.clear();
+  VkBuffer upload_buffer_previous = VK_NULL_HANDLE;
+  while (upload_range_length) {
+    VkBuffer upload_buffer;
+    VkDeviceSize upload_buffer_offset, upload_buffer_size;
+    uint8_t* upload_buffer_mapping = upload_buffer_pool_->RequestPartial(
+        submission_current, upload_range_length, kUnwatchedUploadAlignment, upload_buffer,
+        upload_buffer_offset, upload_buffer_size);
