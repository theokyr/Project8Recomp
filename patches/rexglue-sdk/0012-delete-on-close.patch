diff --git a/src/system/xfile.cpp b/src/system/xfile.cpp
index 418f4b9..6dc89b7 100644
--- a/src/system/xfile.cpp
+++ b/src/system/xfile.cpp
@@ -37,7 +37,31 @@ XFile::XFile() : XObject(kObjectType) {
 XFile::~XFile() {
   // TODO(benvanik): signal that the file is closing?
   async_event_->Set();
+
+  // NOTE(thps-p8 0012): honour delete-on-close.
+  // NtSetInformationFile(FileDispositionInformation) only records the request
+  // on the entry; nothing ever acted on it, so the guest's "delete this file
+  // when I close the handle" was silently dropped and the file survived. A
+  // title that overwrites a save by deleting the old file and recreating it
+  // then loops forever on its own overwrite prompt, because the file it just
+  // asked to be deleted is still there.
+  //
+  // The host handle has to be closed before the host file can be removed, so
+  // read the entry (and the name for the log line - Delete() destroys the
+  // entry) before Destroy(), and delete after it.
+  auto* entry = file_ ? file_->entry() : nullptr;
+  const bool delete_on_close = entry && entry->delete_on_close();
+  const std::string entry_path = delete_on_close ? entry->absolute_path() : std::string();
+
   file_->Destroy();
+
+  if (delete_on_close) {
+    if (entry->Delete()) {
+      REXFS_DEBUG("Deleted '{}' on handle close (delete-on-close)", entry_path);
+    } else {
+      REXFS_WARN("delete-on-close failed for '{}'", entry_path);
+    }
+  }
 }
 
 uint64_t XFile::position() const {
