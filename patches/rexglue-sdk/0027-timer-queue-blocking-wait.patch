+// Keep both strategies in one diagnostic binary so control and treatment can
+// differ only by a cvar. Always signal the blocking strategy: this also keeps
+// a runtime cvar change from stranding a waiter that entered while enabled.
+class TimerQueueWaitStrategy {
+ public:
+  dp::sequence_t wait_until_published(
+      dp::sequence_t sequence, size_t count,
+      const std::atomic<dp::sequence_t>* const sequences[]) {
+    if (REXCVAR_GET(timer_queue_blocking_wait)) {
+      return blocking_.wait_until_published(sequence, count, sequences);
+    }
+    return spin_.wait_until_published(sequence, count, sequences);
+  }
+
+  template <typename Rep, typename Period>
+  dp::sequence_t wait_until_published(
+      dp::sequence_t sequence, size_t count,
+      const std::atomic<dp::sequence_t>* const sequences[],
+      const std::chrono::duration<Rep, Period>& timeout) {
+    if (REXCVAR_GET(timer_queue_blocking_wait)) {
+      return blocking_.wait_until_published(sequence, count, sequences,
+                                             timeout);
+    }
+    return spin_.wait_until_published(sequence, count, sequences, timeout);
+  }
+
+  template <typename Clock, typename Duration>
+  dp::sequence_t wait_until_published(
+      dp::sequence_t sequence, size_t count,
+      const std::atomic<dp::sequence_t>* const sequences[],
+      const std::chrono::time_point<Clock, Duration>& timeout_time) {
+    if (REXCVAR_GET(timer_queue_blocking_wait)) {
+      return blocking_.wait_until_published(sequence, count, sequences,
+                                             timeout_time);
+    }
+    return spin_.wait_until_published(sequence, count, sequences, timeout_time);
+  }
+
+  void signal_all_when_blocking() { blocking_.signal_all_when_blocking(); }
+
+ private:
+  dp::spin_wait_strategy spin_;
+  dp::blocking_wait_strategy blocking_;
+};
