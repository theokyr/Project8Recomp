+#include <atomic>
 #include <rex/assert.h>
 #include <rex/audio/audio_driver.h>
 #include <rex/audio/audio_system.h>
@@ -102,8 +103,38 @@ void AudioSystem::WorkerThreadMain() {
     // These handles signify the number of submitted samples. Once we reach
     // 64 samples, we wait until our audio backend releases a semaphore
     // (signaling a sample has finished playing)
+    // Dispatch-rate instrumentation (2026-08-20). The worker burns 77% of a
+    // core with zero profile samples in guest code, and removing the poll
+    // sleep, the lock churn and a per-slice allocation each changed nothing -
+    // so the question is whether this loop is turning over far faster than the
+    // audio hardware consumes buffers. At 48 kHz with the usual frame size the
+    // healthy rate is a couple of hundred dispatches a second.
+    static std::atomic<uint64_t> waits{0}, successes{0}, timeouts{0}, dispatches{0};
+    static std::atomic<int64_t> next_report{0};
+    waits.fetch_add(1, std::memory_order_relaxed);
     auto result = rex::thread::WaitAny(wait_handles_, rex::countof(wait_handles_), true,
                                        std::chrono::milliseconds(500));
+    if (result.first == rex::thread::WaitResult::kSuccess) {
+      successes.fetch_add(1, std::memory_order_relaxed);
+    } else if (result.first == rex::thread::WaitResult::kTimeout) {
+      timeouts.fetch_add(1, std::memory_order_relaxed);
+    }
+    {
+      auto now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+      int64_t due = next_report.load(std::memory_order_relaxed);
+      if (now_ms >= due &&
+          next_report.compare_exchange_strong(due, now_ms + 1000, std::memory_order_relaxed)) {
+        static uint64_t lw = 0, ls = 0, lt = 0, ld = 0;
+        uint64_t w = waits.load(), su = successes.load(), t = timeouts.load(),
+                 d = dispatches.load();
+        REXAPU_DEBUG(
+            "AudioWorker rate: {} waits/s ({} success, {} timeout), {} guest dispatches/s",
+                    w - lw, su - ls, t - lt, d - ld);
+        lw = w; ls = su; lt = t; ld = d;
+      }
+    }
     if (result.first == rex::thread::WaitResult::kFailed) {
       REXAPU_WARN("AudioWorker: WaitAny failed");
       continue;
@@ -141,6 +172,7 @@ void AudioSystem::WorkerThreadMain() {
                        client_callback, client_callback_arg, index);
         }
         SCOPE_profile_cpu_i("apu", "rex::audio::AudioSystem->client_callback");
+        dispatches.fetch_add(1, std::memory_order_relaxed);
         uint64_t args[] = {client_callback_arg};
         function_dispatcher_->Execute(worker_thread_->thread_state(), client_callback, args,
                                       rex::countof(args));
