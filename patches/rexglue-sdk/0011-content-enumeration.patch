--- a/src/system/kernel_state.cpp
+++ b/src/system/kernel_state.cpp
@@ -1146,6 +1146,9 @@ void KernelState::CompleteOverlappedEx(uint32_t overlapped_ptr, X_RESULT result,
     auto ev = object_table()->LookupObject<XEvent>(event_handle);
     assert_not_null(ev);
     if (ev) {
+      // NOTE(thps-p8 0011): read-only instrumentation, debug level.
+      REXSYS_DEBUG("Overlapped {:08X}: signalling event {:08X} (result {:08X})", overlapped_ptr,
+                   event_handle, result);
       ev->Set(0, false);
     }
   }
@@ -1220,6 +1223,27 @@ void KernelState::CompleteOverlappedDeferredEx(
   auto ptr = memory()->TranslateVirtual(overlapped_ptr);
   XOverlappedSetResult(ptr, X_ERROR_IO_PENDING);
   XOverlappedSetContext(ptr, XThread::GetCurrentThreadHandle());
+  // An overlapped operation that returns before it has completed must leave its
+  // event object non-signalled - the guest waits on that event and only then
+  // reads back the result word. Without the reset the event can still carry the
+  // signal from a previous operation on the same XOVERLAPPED (a preceding
+  // *Immediate* completion nobody waited on, say), so the very first wait
+  // returns instantly and the guest reads X_ERROR_IO_PENDING as if it were the
+  // operation's result. Same rule as Win32 overlapped I/O: the system sets the
+  // event to non-signalled when the call returns with the operation pending.
+  X_HANDLE pending_event_handle = XOverlappedGetEvent(ptr);
+  if (pending_event_handle) {
+    auto ev = object_table()->LookupObject<XEvent>(pending_event_handle);
+    if (ev) {
+      // NOTE(thps-p8 0011): read-only instrumentation, debug level.
+      uint32_t ev_type = 0, ev_state = 0;
+      ev->Query(&ev_type, &ev_state);
+      REXSYS_DEBUG(
+          "CompleteOverlappedDeferredEx: overlapped {:08X} event {:08X} type={} state={} -> reset",
+          overlapped_ptr, pending_event_handle, ev_type, ev_state);
+      ev->Reset();
+    }
+  }
   auto global_lock = global_critical_region_.Acquire();
   dispatch_queue_.push_back(
       [this, completion_callback, overlapped_ptr, pre_callback, post_callback]() {
