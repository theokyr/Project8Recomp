diff --git a/include/rex/ui/surface_sdl.h b/include/rex/ui/surface_sdl.h
new file mode 100644
index 0000000000000000000000000000000000000000..f3262e25001d2c45351dee4136525e986b83f1c1
--- /dev/null
+++ b/include/rex/ui/surface_sdl.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <SDL3/SDL_video.h>
+
+#include <rex/ui/surface.h>
+
+namespace rex::ui {
+
+class SdlWindowSurface final : public Surface {
+ public:
+  explicit SdlWindowSurface(SDL_Window* window) : window_(window) {}
+
+  TypeIndex GetType() const override { return kTypeIndex_SdlWindow; }
+  SDL_Window* window() const { return window_; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override {
+    int width = 0;
+    int height = 0;
+    if (!window_ || !SDL_GetWindowSizeInPixels(window_, &width, &height)) {
+      width_out = 0;
+      height_out = 0;
+      return false;
+    }
+    width_out = static_cast<uint32_t>(width);
+    height_out = static_cast<uint32_t>(height);
+    return true;
+  }
+
+ private:
+  SDL_Window* window_;
+};
+
+}  // namespace rex::ui
