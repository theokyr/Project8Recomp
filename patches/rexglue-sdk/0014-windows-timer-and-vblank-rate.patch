 bool SDLAudioDriver::Initialize() {
-  // Prevent SDL from interfering with timer resolution (causes FPS drops)
-  SDL_SetHintWithPriority(SDL_HINT_TIMER_RESOLUTION, "0", SDL_HINT_OVERRIDE);
+  // Do NOT set SDL_HINT_TIMER_RESOLUTION to "0" here. SDL reads "0" as "call
+  // timeEndPeriod and never re-arm", which leaves the process on Windows'
+  // default 15.625 ms system timer period; SDL's own default is 1 ms. With
+  // the coarse period every ::Sleep() in the runtime - the vblank worker's
+  // deadline wait, the command processor's WAIT_REG_MEM backoff - is
+  // quantised to 15.625 ms, so the guest vblank cannot be delivered faster
+  // than ~64 Hz and, at a 16.67 ms request, lands on 31.25 ms and halves it
+  // to ~32 Hz. The title's frame limiter waits on that counter, so the whole
+  // game runs at half rate while spinning. The comment this replaces claimed
+  // the opposite ("causes FPS drops"); it is inherited and is backwards for a
+  // runtime that paces itself off sleeps.
 
   // Set audio category for proper OS audio handling
   SDL_SetHint(SDL_HINT_AUDIO_CATEGORY, "playback");
