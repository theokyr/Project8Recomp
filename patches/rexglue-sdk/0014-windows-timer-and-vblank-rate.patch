+// Sleeps until at least the given steady_clock deadline.
+//
+// Not the same as Sleep(deadline - now): on Windows a plain ::Sleep() is
+// quantised to the system timer period, which is 15.625 ms by default, so a
+// deadline-driven worker built on it wakes late by up to a whole period and
+// cannot hold any rate finer than 64 Hz. This uses a high-resolution waitable
+// timer there, and clock_nanosleep against the deadline elsewhere, so callers
+// that need to hold a rate do not have to know which platform they are on.
+void SleepUntil(std::chrono::steady_clock::time_point deadline);
+
 enum class SleepResult {
   kSuccess,
   kAlerted,
diff --git a/src/core/threading_win.cpp b/src/core/threading_win.cpp
index 896dfec..71a5a43 100644
--- a/src/core/threading_win.cpp
+++ b/src/core/threading_win.cpp
@@ -97,10 +97,43 @@ void Sleep(std::chrono::microseconds duration) {
   if (duration.count() < 100) {
     MaybeYield();
   } else {
-    ::Sleep(static_cast<DWORD>(duration.count() / 1000));
+    // Round up, and never round a real request down to ::Sleep(0). Integer
+    // division truncated every sub-millisecond request to a bare yield and
+    // every other one to less than was asked for, which breaks this
+    // function's own "at least as long as" contract - and on a spin/backoff
+    // path a yield instead of a sleep is a busy loop.
+    auto ms = (duration.count() + 999) / 1000;
+    ::Sleep(static_cast<DWORD>(ms));
   }
 }
 
+void SleepUntil(std::chrono::steady_clock::time_point deadline) {
+  // A high-resolution waitable timer honours sub-millisecond deadlines
+  // without raising the process-wide timer period, so this holds a rate even
+  // if nothing has called timeBeginPeriod(). Win10 1803+; on older systems
+  // CreateWaitableTimerExW fails and the ::Sleep fallback below is used,
+  // which is what the caller would have got anyway.
+  static thread_local HANDLE timer = CreateWaitableTimerExW(
+      nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+  auto now = std::chrono::steady_clock::now();
+  if (deadline <= now) {
+    return;
+  }
+  auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(deadline - now).count();
+  if (timer) {
+    LARGE_INTEGER due;
+    due.QuadPart = -(ns / 100);  // negative = relative, 100 ns units
+    if (due.QuadPart == 0) {
+      due.QuadPart = -1;
+    }
+    if (SetWaitableTimerEx(timer, &due, 0, nullptr, nullptr, nullptr, 0)) {
+      WaitForSingleObject(timer, INFINITE);
+      return;
+    }
+  }
+  Sleep(std::chrono::duration_cast<std::chrono::microseconds>(deadline - now));
+}
