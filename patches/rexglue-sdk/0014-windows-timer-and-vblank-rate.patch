+void SleepUntil(std::chrono::steady_clock::time_point deadline) {
+  auto now = std::chrono::steady_clock::now();
+  if (deadline <= now) {
+    return;
+  }
+  // nanosleep against the remaining duration: CLOCK_MONOTONIC and
+  // steady_clock share an epoch here, but going through the duration keeps
+  // this correct on any libstdc++ that does not.
+  Sleep(std::chrono::duration_cast<std::chrono::microseconds>(deadline - now));
+}
