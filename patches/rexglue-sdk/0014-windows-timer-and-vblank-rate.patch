         // slipped a whole vblank. Sleep to the absolute next edge instead.
+        // A late wake may owe more than one vblank; a suspended process may
+        // owe thousands. Cap what one wake can deliver.
+        constexpr uint64_t kMaxVblanksPerWake = 4;
         uint64_t last_frame_time = chrono::Clock::QueryGuestTickCount();
         auto next_wake = std::chrono::steady_clock::now();
         while (vsync_worker_running_) {
@@ -180,13 +184,34 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
             next_wake = now;  // fell far behind (suspend/debugger): resync, no burst
           }
           if (next_wake > now) {
-            std::this_thread::sleep_until(next_wake);
+            // Not std::this_thread::sleep_until: on Windows that is ::Sleep(),
+            // quantised to the system timer period, so the deadline this loop
+            // is built around cannot actually be met.
+            rex::thread::SleepUntil(next_wake);
           }
           uint64_t current_time = chrono::Clock::QueryGuestTickCount();
           if (current_time - last_frame_time >= interval_ticks) {
-            MarkVblank();
-            // Track guest time without accumulating drift, but never burst.
+            // Deliver the vblanks that actually elapsed, not one per wake.
+            //
+            // Marking exactly one and then advancing last_frame_time by the
+            // full backlog silently DIVIDES the vblank rate whenever a wake
+            // runs long: two intervals of guest time pass, one interrupt is
+            // delivered, and the rest is discarded. The guest's frame limiter
+            // waits on this counter, so the title runs at the divided rate and
+            // spins out the difference. Where sleeps are precise the backlog
+            // is always 1 and this is identical to marking one; where they are
+            // not, it is the difference between the right rate and half of it.
+            //
+            // Still bounded, which is what the "never burst" rule was for: a
+            // suspend or a debugger stop must not deliver a thousand queued
+            // interrupts at once. The deep-backlog case is already handled by
+            // the resync above.
             uint64_t behind = (current_time - last_frame_time) / interval_ticks;
+            uint64_t deliver = std::min<uint64_t>(behind, kMaxVblanksPerWake);
+            for (uint64_t i = 0; i < deliver; ++i) {
+              MarkVblank();
+            }
+            // Track guest time without accumulating drift.
             last_frame_time += behind * interval_ticks;
           }
         }
