+// Lock-free linear guest-clock scale for the QueryGuestTickCount fast path.
+// guest = base_guest + ((host - base_host) * mul128) >> 64. Writers hold
+// tick_mutex_ and flip the sequence odd->even around updates (seqlock).
+struct GuestScaleState {
+  uint64_t base_host;
+  uint64_t base_guest;
+  unsigned __int128 mul;
+};
+std::atomic<uint32_t> guest_scale_seq_{0};
+GuestScaleState guest_scale_{};
+
+// Callers must hold tick_mutex_.
+void PublishGuestScale() {
+  uint64_t host_now = Clock::QueryHostTickCount();
+  uint64_t host_delta = host_now > last_host_tick_count_ ? host_now - last_host_tick_count_ : 0;
+  last_guest_tick_count_ += host_delta * guest_tick_ratio_.first / guest_tick_ratio_.second;
+  last_host_tick_count_ = host_now;
+  uint32_t s = guest_scale_seq_.load(std::memory_order_relaxed);
+  guest_scale_seq_.store(s + 1, std::memory_order_release);
+  guest_scale_.base_host = host_now;
+  guest_scale_.base_guest = last_guest_tick_count_;
+  guest_scale_.mul = guest_tick_ratio_.second
+                         ? (static_cast<unsigned __int128>(guest_tick_ratio_.first) << 64) /
+                               guest_tick_ratio_.second
+                         : 0;
+  guest_scale_seq_.store(s + 2, std::memory_order_release);
+}
